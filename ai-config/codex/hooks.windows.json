{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "cmd /d /c \"%USERPROFILE%\\.codex\\herdr-agent-state.cmd\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "cmd /d /c py -3 \"%USERPROFILE%\\.codex\\hooks\\herdr-tab-title.py\" codex",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
