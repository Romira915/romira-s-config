# Match the active iTerm2 Fish profile.
font-family = "PlemolJP Console NF"
font-size = 22

background = #300A24
foreground = #C7C7C7
cursor-color = #BBBBBB
selection-background = #B5D5FF
selection-foreground = #000000
background-opacity = 0.847418
background-blur = false

palette = 0=#000000
