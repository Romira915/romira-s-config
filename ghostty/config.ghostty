palette = 2=#00BB00
palette = 3=#BBBB00
palette = 4=#0000BB
palette = 5=#BB00BB
palette = 6=#00BBBB
palette = 7=#BBBBBB
palette = 8=#555555
palette = 9=#FF5555
palette = 10=#55FF55
palette = 11=#FFFF55
palette = 12=#5555FF
palette = 13=#FF55FF
palette = 14=#55FFFF
palette = 15=#FFFFFF
